<?xml version="1.0"?>
<ruleset name="Hide A Post">
	<description>WordPress Coding Standards and PHP 7.4–8.5 compatibility for Hide A Post.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="7.4-8.5"/>

	<rule ref="WordPress"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="hide-a-post"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="hap_"/>
			</property>
		</properties>
		<!-- The WordPress test suite config must define unprefixed core constants. -->
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Test files follow PHPUnit naming (test-*.php) and set WordPress globals. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
